# ─── Server Configuration ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Connection ─────────────────────────────────────────────────────
# Replace with your MongoDB local URI or Atlas connection string
MONGODB_URI=mongodb://localhost:27017/padosi

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=30d

# ─── Client URL (CORS configuration) ────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email Services (Resend) ────────────────────────────────────────────────
# Get your free API key at: https://resend.com/
# Note: If RESEND_API_KEY is omitted, the server runs in fallback mode 
# where email OTPs are printed directly to the server terminal console.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ─── Cloudinary Media Storage (Optional) ────────────────────────────────────
# Get your free account at: https://cloudinary.com/
# Note: If Cloudinary keys are omitted, the server falls back to local disk storage 
# in the 'uploads/' folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
